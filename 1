local function handleChatMessage(senderName, messageText)
    if not state.chatLogger then return end
    if senderName == LocalPlayer.DisplayName and not state.logOwnMessages then return end

    print(string.format("[ZAKZAR CHAT] %s: %s", senderName, messageText))
    notify("CHAT (" .. senderName .. ")", messageText, 3, colors.accent)
end

pcall(function()
    TextChatService.MessageReceived:Connect(function(msg)
        if msg.TextSource then
            local sender = Players:GetPlayerByUserId(msg.TextSource.UserId)
            handleChatMessage(sender and sender.DisplayName or "Unknown", msg.Text)
        end
    end)
end)

for _, plr in pairs(Players:GetPlayers()) do
