local function switchTab(tabIndex)
    activeTab = tabIndex
    for i, tabData in ipairs(tabs) do
        tabData.frame.Visible = (i == tabIndex)
        local btn = tabButtons[i]
        local isActive = (i == tabIndex)
        tween(btn, 0.15, { BackgroundColor3 = isActive and colors.accent or colors.sidebar })
        for _, child in pairs(btn:GetChildren()) do
            if child:IsA("Frame") then child:Destroy() end
        end
        drawIcon(btn, tabDefinitions[i].iconType, isActive and colors.bright or colors.dim)
    end
end

