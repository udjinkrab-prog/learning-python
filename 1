        BorderSizePixel = 0,
        Parent = track
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

    local function setToggle(value, skipCallback)
        isToggled = value
        local targetPos = isToggled and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
