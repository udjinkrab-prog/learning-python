-- Логика радара игроков
local notifiedPlayers = {}
task.spawn(function()
    while task.wait(1) do
        for _, child in pairs(detectorScroll:GetChildren()) do
            if child:IsA("Frame") then
                child:Destroy()
            end
        end

        local myChar = LocalPlayer.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local otherHRP = plr.Character.HumanoidRootPart
                local dist = myHRP and math.floor((otherHRP.Position - myHRP.Position).Magnitude) or 9999

                local row = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 24),
                    BackgroundColor3 = colors.surface,
                    Parent = detectorScroll
                })
                create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = row })

                create("TextLabel", {
                    Text = plr.DisplayName,
                    Font = fonts.medium,
                    TextSize = 10,
                    TextColor3 = colors.bright,
                    Position = UDim2.new(0, 6, 0, 0),
                    Size = UDim2.new(0.65, 0, 1, 0),
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    BackgroundTransparency = 1,
                    Parent = row
                })

                local distColor = colors.text
                if dist <= 100 then
                    distColor = colors.red
                elseif dist <= 300 then
                    distColor = colors.orange
                end

                create("TextLabel", {
                    Text = dist .. "m",
                    Font = fonts.bold,
                    TextSize = 10,
                    TextColor3 = distColor,
                    Position = UDim2.new(0.65, 0, 0, 0),
                    Size = UDim2.new(0.35, -6, 1, 0),
                    TextXAlignment = Enum.TextXAlignment.Right,
                    BackgroundTransparency = 1,
                    Parent = row
                })

                -- Оповещение при приближении игрока на 1000 метров
                if dist <= 1000 and not notifiedPlayers[plr.UserId] then
                    notifiedPlayers[plr.UserId] = true
                    notify("RADAR WARNING", plr.DisplayName .. " nearby: " .. dist .. "m", 4, colors.orange)
                elseif dist > 1100 then
                    notifiedPlayers[plr.UserId] = nil
                end
            end
        end
    end
end)

