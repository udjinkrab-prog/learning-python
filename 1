            if mobHRP then
                local targetCF = hrp.CFrame
                    * CFrame.new(0, state.bringHeight, 0)
                    * CFrame.Angles(0, math.rad(state.bringRotation), 0)
                    * CFrame.new(0, 0, -state.bringDistance)

                local success, _ = pcall(function()
