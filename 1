        if state.autoFarm then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local mobsContainer = workspace:FindFirstChild("Mobs") or workspace
                local closestMob = nil
                local shortestDist = math.huge

                for _, mob in pairs(mobsContainer:GetChildren()) do
                    if mob:IsA("Model") and mob ~= char and mob:FindFirstChildOfClass("Humanoid") then
                        local mobHum = mob:FindFirstChildOfClass("Humanoid")
                        local mobRoot = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
                        if mobHum and mobHum.Health > 0 and mobRoot then
                            local d = (mobRoot.Position - hrp.Position).Magnitude
                            if d < shortestDist then
                                shortestDist = d
                                closestMob = mobRoot
                            end
                        end
                    end
                end

                if closestMob then
                    hrp.CFrame = CFrame.new(closestMob.Position + Vector3.new(0, 4, 0), closestMob.Position)
                    pcall(function()
                        local tool = char:FindFirstChildOfClass("Tool")
                        if tool then tool:Activate() end
                    end)
                end
            end
        end
    end
end)

-- 📚 11.7 АВТО-ЛУТ (AUTO LOOT)
-- 📚 [CRITICAL FIX V6 #4]: Безопасный запуск ProximityPrompt: сначала проверка fireproximityprompt,
-- затем полнофункциональный фоллбэк через InputHoldBegin / task.wait / InputHoldEnd.
task.spawn(function()
    while task.wait(0.5) do
        if state.autoLoot then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                for _, obj in pairs(workspace:GetDescendants()) do
                    if not state.autoLoot then break end

                    if obj:IsA("ProximityPrompt") and obj.Enabled then
                        local promptPart = obj.Parent
                        local promptPos = nil
                        if promptPart:IsA("BasePart") then
                            promptPos = promptPart.Position
                        elseif promptPart:IsA("Model") then
                            promptPos = promptPart:GetPivot().Position
                        elseif promptPart:IsA("Attachment") then
                            promptPos = promptPart.WorldPosition
                        end

                        if promptPos and (promptPos - hrp.Position).Magnitude <= state.lootDistance then
                            local promptTriggered = false
                            if typeof(fireproximityprompt) == "function" then
                                local ok = pcall(function()
                                    fireproximityprompt(obj)
                                end)
                                if ok then promptTriggered = true end
                            end

                            if not promptTriggered then
                                pcall(function()
                                    obj:InputHoldBegin()
                                    local hold = obj.HoldDuration or 0
                                    if hold > 0 then
                                        task.wait(hold)
                                    else
                                        task.wait(0.05)
                                    end
                                    obj:InputHoldEnd()
                                end)
                            end
                        end
                    elseif obj:IsA("TouchTransmitter") then
                        local part = obj.Parent
                        if part and part:IsA("BasePart") and (part.Position - hrp.Position).Magnitude <= state.lootDistance then
                            if typeof(firetouchinterest) == "function" then
                                pcall(function()
                                    firetouchinterest(hrp, part, 0)
                                    task.wait()
                                    firetouchinterest(hrp, part, 1)
                                end)
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- 📚 11.8 СИСТЕМА ESP (PLAYER & MOBS HIGHLIGHTS)
local function createESP(model, isPlayer)
    if espStorage[model] then return end

    local color = isPlayer and colors.yellow or colors.red
    local highlight = Instance.new("Highlight")
    highlight.Name = "ZAKZAR_ESP_Highlight"
    highlight.Adornee = model
    highlight.FillColor = color
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0.2
    highlight.Parent = screenGui

    local head = model:FindFirstChild("Head") or model.PrimaryPart
    local billboard = nil
    if head then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "ZAKZAR_ESP_Tag"
        billboard.Adornee = head
        billboard.Size = UDim2.new(0, 110, 0, 32)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = screenGui

        create("TextLabel", {
            Name = "NameLabel",
            Text = model.Name,
            Font = fonts.bold,
            TextSize = 10,
            TextColor3 = color,
            Size = UDim2.new(1, 0, 0.5, 0),
            BackgroundTransparency = 1,
            Parent = billboard
        })

        create("TextLabel", {
            Name = "DistLabel",
            Text = "0m",
            Font = fonts.regular,
            TextSize = 9,
            TextColor3 = colors.bright,
            Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.new(1, 0, 0.5, 0),
            BackgroundTransparency = 1,
            Parent = billboard
        })
    end

    espStorage[model] = {
        highlight = highlight,
        billboard = billboard,
        isPlayer = isPlayer
    }
end

local function removeESP(model)
    local data = espStorage[model]
    if data then
        if data.highlight then
            pcall(function() data.highlight:Destroy() end)
        end
        if data.billboard then
            pcall(function() data.billboard:Destroy() end)
        end
        espStorage[model] = nil
    end
end

-- Рендеринг и обновление меток ESP
RunService.RenderStepped:Connect(function()
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

    -- 1. Игроки (Player ESP)
    if state.playerESP then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                if not espStorage[plr.Character] then
                    createESP(plr.Character, true)
                else
                    local data = espStorage[plr.Character]
                    if data.billboard and myHRP and plr.Character:FindFirstChild("HumanoidRootPart") then
                        local d = math.floor((plr.Character.HumanoidRootPart.Position - myHRP.Position).Magnitude)
                        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                        local hpText = (state.espShowHealth and hum) and string.format(" [%d HP]", math.floor(hum.Health)) or ""
                        local distText = state.espShowDist and (d .. "m") or ""
                        local distLabel = data.billboard:FindFirstChild("DistLabel")
                        if distLabel then
                            distLabel.Text = distText .. hpText
                        end
                    end
                end
            end
        end
    else
        for model, data in pairs(espStorage) do
            if data.isPlayer then removeESP(model) end
        end
    end

    -- 2. Мобы (Mobs ESP)
    if state.mobsESP then
        local mobsContainer = workspace:FindFirstChild("Mobs") or workspace
        for _, obj in pairs(mobsContainer:GetChildren()) do
            if obj:IsA("Model") and obj ~= myChar and obj:FindFirstChildOfClass("Humanoid") then
                local root = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                if root and myHRP then
                    local d = (root.Position - myHRP.Position).Magnitude
                    if d <= state.mobsESPDistance then
                        if not espStorage[obj] then
                            createESP(obj, false)
                        else
                            local data = espStorage[obj]
                            if data.highlight then
                                data.highlight.Enabled = state.mobsBoxes
                            end
                            if data.billboard then
                                local mobHum = obj:FindFirstChildOfClass("Humanoid")
                                local hpText = (state.mobsHealthBar and mobHum) and string.format(" [%d HP]", math.floor(mobHum.Health)) or ""
                                local distLabel = data.billboard:FindFirstChild("DistLabel")
                                if distLabel then
                                    distLabel.Text = math.floor(d) .. "m" .. hpText
                                end
                            end
                        end
                    else
                        if espStorage[obj] and not espStorage[obj].isPlayer then
                            removeESP(obj)
                        end
                    end
                end
            end
        end
    else
        for model, data in pairs(espStorage) do
            if not data.isPlayer then removeESP(model) end
        end
    end
end)

