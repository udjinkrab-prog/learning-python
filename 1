    end

    track.MouseButton1Click:Connect(function()
        setToggle(not isToggled)
    end)

    return { set = setToggle, get = function() return isToggled end }
end

-- 9.3 СЛАЙДЕР (INTERACTIVE DRAG SLIDER)
-- 📚 Полностью кастомный интерактивный слайдер через события UserInputService
local function addSlider(sectionCard, labelText, minVal, maxVal, defaultVal, unit, callback)
    unit = unit or ""
    local currentVal = defaultVal

    local row = create("Frame", {
        Name = "SliderRow_" .. labelText,
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
        Parent = sectionCard
    })

    table.insert(searchableElements, { name = labelText:lower(), object = row })

    create("TextLabel", {
        Text = labelText,
        Font = fonts.medium,
        TextSize = 11,
        TextColor3 = colors.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Size = UDim2.new(0.38, 0, 1, 0),
        BackgroundTransparency = 1,
        Parent = row
    })

    local valueLabel = create("TextLabel", {
        Text = tostring(currentVal) .. (unit ~= "" and " " .. unit or ""),
        Font = fonts.bold,
        TextSize = 10,
        TextColor3 = colors.accent,
        TextXAlignment = Enum.TextXAlignment.Right,
        Size = UDim2.new(0.2, 0, 1, 0),
        Position = UDim2.new(0.38, 0, 0, 0),
        BackgroundTransparency = 1,
        Parent = row
    })

    -- Трек слайдера (40% ширины строки, высота 4px)
    local sliderBg = create("Frame", {
        Size = UDim2.new(0.4, 0, 0, 4),
        Position = UDim2.new(0.6, 0, 0.5, -2),
        BackgroundColor3 = colors.track,
        Parent = row
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = sliderBg })

    local ratio = math.clamp((currentVal - minVal) / (maxVal - minVal), 0, 1)

    local fill = create("Frame", {
        Size = UDim2.new(ratio, 0, 1, 0),
        BackgroundColor3 = colors.accent,
        BorderSizePixel = 0,
        Parent = sliderBg
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })

    -- Бегунок слайдера (12x12px)
    local knob = create("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new(ratio, -6, 0.5, -6),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Parent = sliderBg
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

    local dragging = false

    local function updateFromInput(inputX)
        local barAbsPos = sliderBg.AbsolutePosition.X
        local barAbsWidth = sliderBg.AbsoluteSize.X
        if barAbsWidth <= 0 then return end
        local r = math.clamp((inputX - barAbsPos) / barAbsWidth, 0, 1)
        local val = math.floor(minVal + (maxVal - minVal) * r + 0.5)
        currentVal = val

        fill.Size = UDim2.new(r, 0, 1, 0)
        knob.Position = UDim2.new(r, -6, 0.5, -6)
        valueLabel.Text = tostring(val) .. (unit ~= "" and " " .. unit or "")
        task.spawn(callback, val)
    end

    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromInput(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromInput(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return {
        set = function(val)
            currentVal = math.clamp(val, minVal, maxVal)
            local r = (currentVal - minVal) / (maxVal - minVal)
            fill.Size = UDim2.new(r, 0, 1, 0)
