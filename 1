-- 📚 11.3 ПРОХОД СКВОЗЬ СТЕНЫ (NOCLIP) — REWRITTEN V6.1
-- Roblox Humanoid принудительно восстанавливает CanCollide = true на HumanoidRootPart,
-- Head, Torso/UpperTorso ПОСЛЕ события Stepped, но ДО реального расчёта физики.
-- Решение: отключаем коллизию в ТРИ момента кадра (Stepped + RenderStepped + Heartbeat)
-- и дополнительно блокируем стейт-машину гуманоида, чтобы она не вмешивалась.

-- Шаг 1: Ядро — функция отключения коллизий
local function disableCharCollision()
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

-- Шаг 2: Тройная подписка — гарантирует перекрытие любого окна восстановления Humanoid
RunService.Stepped:Connect(function()
    if state.noClip then disableCharCollision() end
end)

RunService.RenderStepped:Connect(function()
    if state.noClip then disableCharCollision() end
end)

RunService.Heartbeat:Connect(function()
    if state.noClip then disableCharCollision() end
end)

-- Шаг 3: Визуальная прозрачность стен — вынесена в отдельный тикер 10 Гц,
-- чтобы не забивать каждый физический фрейм тяжёлым GetPartBoundsInRadius
task.spawn(function()
    while task.wait(0.1) do
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")

        if state.noClip and hrp then
            -- Очистка далёких / удалённых частей
            local toRemove = {}
            for part, origT in pairs(noclipOrigTransparency) do
                if not part or not part.Parent then
                    toRemove[part] = true
                elseif (part.Position - hrp.Position).Magnitude > 12 then
                    pcall(function() part.Transparency = origT end)
                    toRemove[part] = true
                end
            end
            for p in pairs(toRemove) do
                noclipOrigTransparency[p] = nil
            end

            -- Сделать ближайшие стены полупрозрачными
            local params = OverlapParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = { char }
            local nearby = workspace:GetPartBoundsInRadius(hrp.Position, 6, params)
            for _, part in pairs(nearby) do
                if part:IsA("BasePart") and noclipOrigTransparency[part] == nil then
                    noclipOrigTransparency[part] = part.Transparency
                    part.Transparency = math.max(part.Transparency, 0.7)
                end
            end
        elseif not state.noClip and next(noclipOrigTransparency) then
            -- Восстановить прозрачность при выключении
            for part, origT in pairs(noclipOrigTransparency) do
                pcall(function()
                    if part and part.Parent then
                        part.Transparency = origT
                    end
                end)
            end
            table.clear(noclipOrigTransparency)
        end
    end
end)

-- 📚 11.4 ЗАЩИТА ОТ УРОНА ПРИ ПАДЕНИИ (NO FALL DAMAGE)
local function setupFallDamageProtection(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end

    local lastHealth = hum.Health
    local wasFlying = false

    hum.StateChanged:Connect(function(old, new)
        if state.noFallDmg then
            if new == Enum.HumanoidStateType.Freefall then
                wasFlying = true
                lastHealth = hum.Health
            elseif wasFlying and (new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running) then
                task.defer(function()
                    if hum.Health < lastHealth then
                        hum.Health = lastHealth
                    end
                end)
                wasFlying = false
            end
        end
    end)

    hum.HealthChanged:Connect(function(newHealth)
        if state.noFallDmg and wasFlying and newHealth < lastHealth then
            hum.Health = lastHealth
        end
    end)

    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
end

if LocalPlayer.Character then
    setupFallDamageProtection(LocalPlayer.Character)
end

